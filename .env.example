# Copier ce fichier vers .env (ignoré par git) puis adapter si besoin.
# Valeurs par défaut de la base locale : `npm run db:start` les affiche aussi.
# Ne jamais mettre ici la clé service_role ni un secret : ces variables sont
# embarquées dans l'app.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète de la base LOCALE, réservée aux tests d'API (préparation des
# données). Jamais dans l'app, jamais une clé de production : sans le préfixe
# EXPO_PUBLIC_, elle n'est pas embarquée dans l'app.
SUPABASE_SECRET_KEY=
